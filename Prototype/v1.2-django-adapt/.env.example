# Vorlage für Umgebungsvariablen. Als ".env" kopieren, Werte anpassen,
# NIE committen und auf dem Server "chmod 600 .env".
# Django liest die Datei nicht selbst: systemd (EnvironmentFile=), Docker
# (--env-file) oder die Plattform der Spital-IT muss die Werte setzen.

# ---------------------------------------------------------------------------
# Profil
# ---------------------------------------------------------------------------
# development = lokal und aktuelle Schul-VM (HTTP erlaubt, Fallback-Werte)
# production  = Spital-Betrieb (strenge Prüfungen beim Start, HTTPS, kein DEBUG)
DJANGO_ENV=development

# ---------------------------------------------------------------------------
# Kern
# ---------------------------------------------------------------------------
# ANPASSEN (Hosting): In Produktion Pflicht, >= 50 Zeichen, pro Umgebung eigener Wert:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# In Produktion standardmässig false (true bricht dort den Start ab).
DJANGO_DEBUG=false
# ANPASSEN (Hosting): Hostname(s) der Spital-IT, z. B. eras.ksw.ch
DJANGO_ALLOWED_HOSTS=bene-ksw.init-lab.ch,160.85.252.95,127.0.0.1,localhost
# ANPASSEN (Hosting): In Produktion nur https://… eintragen.
DJANGO_CSRF_TRUSTED_ORIGINS=https://bene-ksw.init-lab.ch,http://bene-ksw.init-lab.ch

# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# Standard: SQLite (auch in Produktion). Eigener Datenordner ausserhalb des Codes,
# der App-User braucht Schreibrechte auf den Ordner.
# ANPASSEN (Hosting): In Produktion setzen (deploy/eras.service erlaubt nur dort
# Schreibzugriff). Ohne Wert: db.sqlite3 im Projektordner (lokal/Schul-VM).
# SQLITE_PATH=/opt/eras/data/db.sqlite3
# SQLITE_TIMEOUT_SECONDS=20         # Wartezeit bei gleichzeitigen Schreibzugriffen
#
# Optional: PostgreSQL statt SQLite (z. B. für Kliniken mit eigener DB-Infrastruktur).
# Sobald POSTGRES_DB gesetzt ist, wird PostgreSQL verwendet und SQLITE_PATH ignoriert.
# ANPASSEN (Hosting): Zugangsdaten von der IT.
# POSTGRES_DB=eras
# POSTGRES_USER=eras
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_SSLMODE=prefer          # require/verify-full bei entfernter DB
# POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# HTTPS / Proxy (Standard: in production an, in development aus)
# ---------------------------------------------------------------------------
# DJANGO_HTTPS=true
# DJANGO_BEHIND_TLS_PROXY=true     # Proxy setzt X-Forwarded-Proto
# DJANGO_SSL_REDIRECT=true         # false, wenn der Proxy schon umleitet
# DJANGO_HSTS_SECONDS=3600         # nach erfolgreichem Test: 31536000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=false

# ---------------------------------------------------------------------------
# Django-Admin (Backoffice)
# ---------------------------------------------------------------------------
# ANPASSEN (Hosting): In Produktion schwer erratbaren Pfad wählen und per
# Proxy/Firewall auf das Spitalnetz beschränken.
# DJANGO_ADMIN_URL=admin/
# DJANGO_SESSION_COOKIE_AGE=28800  # Admin-Login läuft nach 8 h ab

# ---------------------------------------------------------------------------
# Betrieb
# ---------------------------------------------------------------------------
# DJANGO_STATIC_ROOT=/opt/eras/app/staticfiles
# DJANGO_LOG_LEVEL=INFO
# GUNICORN_BIND=127.0.0.1:8000
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=90
# GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------------------
# Laborimport (optional)
# ---------------------------------------------------------------------------
LAB_IMPORT_MAX_BYTES=10485760
LAB_IMPORT_MAX_PAGES=10
LAB_IMPORT_MAX_IMAGE_PIXELS=25000000
LAB_IMPORT_OCR_TIMEOUT_SECONDS=30
LAB_IMPORT_OCR_LANG=deu+eng
